#!/usr/bin/env bash
# baggler - check, test, package and (optionally) sync the Baggler addon.  Usage: baggler <command> [addon|all]
set -u
ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
. "$ROOT/project.conf"
SRC="$ROOT/addons"
red(){ printf '\033[31m%s\033[0m\n' "$*"; }; grn(){ printf '\033[32m%s\033[0m\n' "$*"; }; dim(){ printf '\033[2m%s\033[0m\n' "$*"; }

targets() {  # resolve "all"/empty/name into a list, validating names
  local t="${1:-all}"
  if [ "$t" = all ]; then echo $ADDONS; return; fi
  for a in $ADDONS; do [ "$a" = "$t" ] && { echo "$a"; return; }; done
  red "unknown or unmanaged add-on '$t' (managed: $ADDONS; pending: ${PENDING:-none})" >&2; return 1
}

cmd_status() {  # compare project vs installed copy
  local selected; selected=$(targets "${1:-all}") || return 1
  for a in $selected; do
    local v; v=$(grep -m1 '^## Version' "$SRC/$a/$a.toc" | cut -d' ' -f3)
    local i; i=$(grep -m1 '^## Interface' "$SRC/$a/$a.toc" | cut -d' ' -f3)
    if [ ! -d "$ADDONS_DIR/$a" ]; then echo "$a  v$v  interface $i  NOT INSTALLED"; continue; fi
    local d; d=$(rsync -rcn --delete --itemize-changes "$SRC/$a/" "$ADDONS_DIR/$a/" | grep -v '^\.' | wc -l)
    [ "$d" = 0 ] && echo "$a  v$v  interface $i  installed copy matches" || echo "$a  v$v  interface $i  $d file(s) differ from installed copy"
  done
  if [ -n "${PENDING:-}" ]; then dim "pending (not managed yet): $PENDING"; fi
}

cmd_check() {  # syntax + toc + tests, no installing
  local fail=0
  local selected; selected=$(targets "${1:-all}") || return 1
  for a in $selected; do
    for f in $(grep -E '\.lua$' "$SRC/$a/$a.toc"); do [ -f "$SRC/$a/$f" ] || { red "$a: TOC lists missing file $f"; fail=1; }; done
    for f in "$SRC/$a"/*.lua; do luajit -e "assert(loadfile('$f'))" 2>&1 | head -1 | grep . && fail=1; done
    grep -q '^## Interface' "$SRC/$a/$a.toc" || { red "$a: no Interface line"; fail=1; }
  done
  # Never overwrite Blizzard's tables/functions from add-on code: it taints them for the game's own secure code.
  if grep -rnE "^[[:space:]]*(C_Container|C_Item|C_Spell|C_ActionBar|_G\.(UseContainerItem|PickupContainerItem|CastSpellByName|UseAction))\.?[A-Za-z_]*[[:space:]]*=[^=]|^[[:space:]]*(Container|C_Container)\.[A-Za-z]+[[:space:]]*=[^=]" --include=*.lua "$SRC" 2>/dev/null | grep -v '/Tests/' ; then
    red "an add-on assigns into a Blizzard API table (taint risk) - see lines above"; fail=1
  fi
  [ $fail = 0 ] && grn "check: syntax + TOC ok" || { red "check: FAILED"; return 1; }
}

cmd_test() {  # Run the actual standalone Baggler TOC and regression suites.
