cmd_sync() {  # project -> game folder (only the named add-ons; never touches anything else)
  cmd_check "${1:-all}" || { red "refusing to install a broken tree"; return 1; }
  local selected; selected=$(targets "${1:-all}") || return 1
  for a in $selected; do
    rsync -a --delete --exclude='.git' --exclude='README.md' "$SRC/$a/" "$ADDONS_DIR/$a/" && grn "installed $a"
  done
  dim "in game: /reload"
}

cmd_pull() {  # game folder -> project (rescue edits made directly in the game folder)
  local selected; selected=$(targets "${1:-all}") || return 1
  for a in $selected; do rsync -a --exclude='.git' "$ADDONS_DIR/$a/" "$SRC/$a/" && grn "pulled $a"; done
}

cmd_interface() {  # update-day: baggler interface 16002[,120107]  -> rewrites every managed TOC
  [ -z "${1:-}" ] && { echo "usage: baggler interface <number[,number...]>"; return 1; }
  for a in $ADDONS; do sed -i "s/^## Interface:.*/## Interface: $1/" "$SRC/$a/$a.toc"; echo "$a -> $1"; done
}

cmd_version() {  # baggler version 0.2.0  -> sets every managed add-on's version
  [ -z "${1:-}" ] && { echo "usage: baggler version <x.y.z>"; return 1; }
  for a in $ADDONS; do sed -i "s/^## Version:.*/## Version: $1/" "$SRC/$a/$a.toc"; done; echo "all managed add-ons now v$1"
}

cmd_pack() {  # public ZIP name; Baggler is the install/loader directory
  local selected; selected=$(targets "${1:-all}") || return 1
  cmd_check "${1:-all}" || return 1
  python3 "$ROOT/tools/package_baggler.py"
}

cmd_install_all() { cmd_sync all; }

case "${1:-help}" in
  status) cmd_status "${2:-all}";; check) cmd_check "${2:-all}";; test) cmd_test;;
  sync|install) cmd_sync "${2:-all}";; pull) cmd_pull "${2:-all}";;
  interface) cmd_interface "${2:-}";; version) cmd_version "${2:-}";; pack) cmd_pack "${2:-}";;
  *) cat <<H
baggler <command> [addon|all]
  status [a]     does the installed copy match the project?
  check  [a]     syntax + TOC sanity (no install)
  test           run the simulated-WoW test suites
  sync   [a]     check, then install into the game's AddOns (project is the source of truth)
  pull   [a]     copy game-folder edits back into the project
  interface N    update-day: set ## Interface for every add-on
  version X.Y.Z  set the version on every add-on
  pack [a]       build dist/Baggler-<ver>.zip (Baggler/ only)
H
esac
